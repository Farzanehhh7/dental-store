# Server & Public Site URL
PORT=3000
NODE_ENV=development
SITE_URL=
DATA_DIR=.data
# Required in production (minimum 32 random characters for HMAC token/cookie hashing)
SESSION_SECRET=
# Set to 'true' (or hop count like '1') when running behind an HTTPS reverse proxy
TRUST_PROXY=false
# Comma-separated list of allowed cross-origin URLs for CORS (empty = same-origin only)
ALLOWED_ORIGINS=

# Rate Limiting (window in ms and max requests per IP within window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_ORDER_PAYMENT_MAX=30
RATE_LIMIT_TELEMETRY_MAX=60
RATE_LIMIT_GLOBAL_MAX=300

# SMS / OTP Configuration & Hardening (fail-closed if unset: set 'sandbox' for local testing or 'live' for production)
SMS_PROVIDER=
SMS_API_KEY=
SMS_OTP_TEMPLATE=
OTP_EXPIRY_SECONDS=180
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_PHONE_WINDOW_MAX=5

# Hardened Upload Limits (bytes, default 5 MiB)
UPLOAD_MAX_BYTES=5242880

# Repository Storage Driver ('file' default for local/Starter Tier, 'firestore' for user-owned GCP project with Firebase Admin IAM)
STORAGE_DRIVER=file

# Payment Gateway Configuration (fail-closed if unset: set 'sandbox' for local testing or 'live' for production)
PAYMENT_MODE=
ALLOW_SANDBOX_IN_PROD=false
ORDER_PAYMENT_EXPIRY_MINUTES=30
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=60000
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Analytics (optional)
GA_MEASUREMENT_ID=
MATOMO_URL=
MATOMO_SITE_ID=