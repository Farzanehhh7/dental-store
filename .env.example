# Server & Public Site URL
PORT=3000
SITE_URL=
DATA_DIR=.data
# Required in production (minimum 32 random characters for HMAC token/cookie hashing)
SESSION_SECRET=
# Set to 'true' (or hop count like '1') when running behind an HTTPS reverse proxy
TRUST_PROXY=false
# Comma-separated list of allowed cross-origin URLs for CORS (empty = same-origin only)
ALLOWED_ORIGINS=

# Rate Limiting (window in ms and max requests per IP within window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_ORDER_PAYMENT_MAX=30
RATE_LIMIT_GLOBAL_MAX=300

# SMS / OTP Configuration (fail-closed if unset: set 'sandbox' for local testing or 'live' for production)
SMS_PROVIDER=
SMS_API_KEY=
SMS_OTP_TEMPLATE=

# Payment Gateway Configuration (fail-closed if unset: set 'sandbox' for local testing or 'live' for production)
PAYMENT_MODE=
ALLOW_SANDBOX_IN_PROD=false
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=

# Analytics (optional)
GA_MEASUREMENT_ID=
MATOMO_URL=
MATOMO_SITE_ID=