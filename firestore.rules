rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive & RBAC Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function hasAdminDoc() {
      return isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return hasAdminDoc() && adminRole() == 'super_admin';
    }

    function isAdmin() {
      return hasAdminDoc();
    }

    function hasRole(allowedRoles) {
      return hasAdminDoc() && adminRole() in allowedRoles;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'customerGroup', 'accountType', 'b2bStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'mobile', 'customerGroup', 'accountType', 'clinicName', 'medicalCouncilNo', 'specialty', 'legalCompanyName', 'economicCode', 'nationalId', 'registrationNo', 'isBlocked', 'b2bStatus', 'addresses', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.customerGroup in ['retail', 'dentist', 'clinic', 'lab', 'student', 'agent', 'wholesale']
        && data.accountType in ['individual', 'clinic', 'lab', 'student', 'agent', 'company']
        && data.b2bStatus in ['none', 'pending', 'approved', 'rejected', 'needs_info']
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20))
        && (!('clinicName' in data) || (data.clinicName is string && data.clinicName.size() <= 160))
        && (!('medicalCouncilNo' in data) || (data.medicalCouncilNo is string && data.medicalCouncilNo.size() <= 40))
        && (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 80))
        && (!('legalCompanyName' in data) || (data.legalCompanyName is string && data.legalCompanyName.size() <= 160))
        && (!('economicCode' in data) || (data.economicCode is string && data.economicCode.size() <= 40))
        && (!('nationalId' in data) || (data.nationalId is string && data.nationalId.size() <= 40))
        && (!('registrationNo' in data) || (data.registrationNo is string && data.registrationNo.size() <= 40))
        && (!('isBlocked' in data) || (data.isBlocked is bool))
        && (!('addresses' in data) || (data.addresses is list && data.addresses.size() <= 10));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNo', 'userId', 'customerName', 'customerMobile', 'status', 'paymentStatus', 'paymentMethod', 'subtotal', 'discountTotal', 'shippingTotal', 'taxTotal', 'grandTotal', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderNo', 'userId', 'isGuest', 'customerName', 'customerMobile', 'customerGroup', 'status', 'paymentStatus', 'paymentMethod', 'subtotal', 'discountTotal', 'shippingTotal', 'taxTotal', 'grandTotal', 'couponCode', 'shippingAddress', 'shippingMethod', 'customerNote', 'items', 'trackingCode', 'proformaId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orderNo is string && data.orderNo.size() >= 1 && data.orderNo.size() <= 40
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() <= 120
        && data.customerMobile is string && data.customerMobile.size() <= 20
        && data.status in ['pending_payment', 'awaiting_review', 'payment_failed', 'paid', 'processing', 'packed', 'shipped', 'delivered', 'completed', 'cancelled', 'expired', 'refunded', 'return_requested', 'returned']
        && data.paymentStatus in ['unpaid', 'partially_paid', 'paid', 'refunded', 'pending_credit']
        && data.paymentMethod in ['online', 'cash_on_delivery', 'bank_transfer', 'credit_request', 'cheque_request', 'installment_request']
        && data.subtotal is number && data.discountTotal is number && data.shippingTotal is number && data.taxTotal is number && data.grandTotal is number
        && data.grandTotal >= 0
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && (!('isGuest' in data) || (data.isGuest is bool))
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40))
        && (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 500))
        && (!('trackingCode' in data) || (data.trackingCode is string && data.trackingCode.size() <= 64));
    }

    function isValidProforma(data) {
      return data.keys().hasAll(['id', 'proformaNo', 'userId', 'contactName', 'contactMobile', 'status', 'subtotal', 'discountTotal', 'taxTotal', 'grandTotal', 'items', 'validUntil', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'proformaNo', 'shareToken', 'userId', 'contactName', 'contactMobile', 'clinicName', 'status', 'subtotal', 'discountTotal', 'taxTotal', 'grandTotal', 'items', 'termsFa', 'validUntil', 'orderId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.proformaNo is string && data.proformaNo.size() <= 40
        && data.userId is string && data.userId.size() <= 128
        && data.contactName is string && data.contactName.size() <= 120
        && data.contactMobile is string && data.contactMobile.size() <= 20
        && data.status in ['draft', 'sent', 'viewed', 'accepted', 'rejected', 'expired', 'converted']
        && data.grandTotal is number && data.grandTotal >= 0
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 100
        && (!('shareToken' in data) || (data.shareToken is string && data.shareToken.size() <= 64))
        && data.validUntil is string && data.validUntil.size() <= 40;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'authorName', 'rating', 'body', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'authorName', 'rating', 'title', 'body', 'status', 'isVerifiedPurchase', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.userId is string && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 1500
        && data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'authorName', 'body', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'authorName', 'body', 'answerBody', 'answeredBy', 'status', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.userId is string && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() <= 80
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 1000
        && data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'ticketNo', 'userId', 'subject', 'department', 'priority', 'status', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ticketNo', 'userId', 'orderNo', 'subject', 'department', 'priority', 'status', 'messages', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.ticketNo is string && data.ticketNo.size() <= 40
        && data.userId is string && data.userId.size() <= 128
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 180
        && data.department in ['sales', 'support', 'accounting', 'technical']
        && data.priority in ['low', 'normal', 'high', 'urgent']
        && data.status in ['open', 'pending_customer', 'pending_staff', 'resolved', 'closed']
        && data.messages is list && data.messages.size() >= 1 && data.messages.size() <= 50;
    }

    function isValidB2BVerification(data) {
      return data.keys().hasAll(['id', 'userId', 'applicantName', 'mobile', 'requestedGroup', 'clinicName', 'medicalCouncilNo', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'applicantName', 'mobile', 'requestedGroup', 'clinicName', 'medicalCouncilNo', 'documentSummary', 'attachmentName', 'attachmentPreview', 'status', 'rejectReason', 'reviewedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() <= 128
        && data.applicantName is string && data.applicantName.size() <= 120
        && data.mobile is string && data.mobile.size() <= 20
        && data.requestedGroup in ['dentist', 'clinic', 'lab', 'student', 'agent', 'wholesale']
        && data.clinicName is string && data.clinicName.size() <= 160
        && data.medicalCouncilNo is string && data.medicalCouncilNo.size() <= 40
        && (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 160))
        && (!('attachmentPreview' in data) || (data.attachmentPreview is string && data.attachmentPreview.size() <= 60000))
        && data.status in ['pending', 'approved', 'rejected', 'needs_info'];
    }

    function isValidPaymentPlan(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'type', 'requestedAmount', 'installmentsCount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderId', 'proformaId', 'userId', 'customerName', 'type', 'requestedAmount', 'installmentsCount', 'proposedTermsFa', 'decisionNote', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() <= 120
        && data.type in ['credit', 'installment', 'cheque']
        && data.requestedAmount is number && data.requestedAmount > 0
        && data.installmentsCount is number && data.installmentsCount >= 1 && data.installmentsCount <= 36
        && data.status in ['submitted', 'under_review', 'needs_info', 'approved', 'rejected', 'active', 'settled', 'defaulted', 'cancelled'];
    }

    function isValidStockRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'contactName', 'mobile', 'titleText', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'contactName', 'mobile', 'titleText', 'brandText', 'description', 'status', 'adminNote', 'createdAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() <= 128
        && data.contactName is string && data.contactName.size() <= 120
        && data.mobile is string && data.mobile.size() <= 20
        && data.titleText is string && data.titleText.size() >= 2 && data.titleText.size() <= 180
        && data.status in ['new', 'in_review', 'sourcing', 'available', 'rejected', 'closed'];
    }

    function isValidConsultation(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'mobile', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'mobile', 'clinicName', 'productId', 'productName', 'budgetRange', 'message', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 120
        && data.mobile is string && data.mobile.size() <= 20
        && data.status in ['new', 'contacted', 'quoted', 'won', 'lost'];
    }

    function isValidReturnRequest(data) {
      return data.keys().hasAll(['id', 'returnNo', 'orderId', 'orderNo', 'userId', 'customerName', 'items', 'reasonFa', 'resolution', 'status', 'refundAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'returnNo', 'orderId', 'orderNo', 'userId', 'customerName', 'items', 'reasonFa', 'resolution', 'status', 'refundAmount', 'condition', 'warehouseId', 'restockedAt', 'adminNote', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.returnNo is string && data.returnNo.size() <= 40
        && data.userId is string && data.userId.size() <= 128
        && data.reasonFa is string && data.reasonFa.size() >= 3 && data.reasonFa.size() <= 500
        && data.resolution in ['refund', 'replacement', 'credit']
        && data.status in ['requested', 'approved', 'received', 'refunded', 'rejected']
        && data.refundAmount is number && data.refundAmount >= 0
        && (!('condition' in data) || data.condition in ['resellable', 'damaged'])
        && (!('warehouseId' in data) || (data.warehouseId is string && data.warehouseId.size() <= 128))
        && (!('restockedAt' in data) || (data.restockedAt is string && data.restockedAt.size() <= 40));
    }

    function isValidRfqRequest(data) {
      return data.keys().hasAll(['id', 'rfqNo', 'userId', 'customerMobile', 'customerName', 'productId', 'productTitleFa', 'variantId', 'variantLabelFa', 'quantity', 'status', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'rfqNo', 'userId', 'customerMobile', 'customerName', 'clinicName', 'productId', 'productTitleFa', 'variantId', 'variantLabelFa', 'quantity', 'targetUnitPrice', 'quotedUnitPrice', 'quotedTotal', 'status', 'validUntil', 'proformaId', 'messages', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.rfqNo is string && data.rfqNo.size() <= 40
        && data.userId is string && data.userId.size() <= 128
        && data.customerMobile is string && data.customerMobile.size() <= 20
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && isValidId(data.productId)
        && data.productTitleFa is string && data.productTitleFa.size() <= 200
        && isValidId(data.variantId)
        && data.variantLabelFa is string && data.variantLabelFa.size() <= 120
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 100000
        && (!('clinicName' in data) || (data.clinicName is string && data.clinicName.size() <= 160))
        && (!('targetUnitPrice' in data) || (data.targetUnitPrice is number && data.targetUnitPrice >= 0))
        && (!('quotedUnitPrice' in data) || (data.quotedUnitPrice is number && data.quotedUnitPrice >= 0))
        && (!('quotedTotal' in data) || (data.quotedTotal is number && data.quotedTotal >= 0))
        && (!('validUntil' in data) || (data.validUntil is string && data.validUntil.size() <= 40))
        && (!('proformaId' in data) || (data.proformaId is string && data.proformaId.size() <= 128))
        && data.status in ['submitted', 'in_review', 'quoted', 'accepted', 'rejected', 'converted']
        && data.messages is list && data.messages.size() >= 1 && data.messages.size() <= 100;
    }

    // --- Public Catalog & Content Collections (Storefront Read, Role-Restricted Admin Write) ---
    match /test/connection {
      allow get: if true;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content', 'sales_mgr']) && isValidId(categoryId) && incoming().nameFa is string && incoming().nameFa.size() <= 120;
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(categoryId);
    }

    match /brands/{brandId} {
      allow get: if isValidId(brandId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content', 'sales_mgr']) && isValidId(brandId) && incoming().nameFa is string && incoming().nameFa.size() <= 120;
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(brandId);
    }

    match /attributes/{attributeId} {
      allow get: if isValidId(attributeId);
      allow list: if resource.data.code is string;
      allow create, update: if hasRole(['super_admin', 'admin', 'content', 'sales_mgr']) && isValidId(attributeId) && incoming().code is string && incoming().code.size() <= 64;
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(attributeId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (resource == null || resource.data.status in ['active', 'out_of_stock', 'coming_soon'] || isAdmin());
      allow list: if resource.data.status in ['active', 'out_of_stock', 'coming_soon'] || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'sales_mgr', 'warehouse', 'content']) && isValidId(productId) && incoming().titleFa is string && incoming().titleFa.size() <= 200;
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(productId);
    }

    // Private supplier buy costs locked strictly to admin + accountant roles (§9.1)
    match /productCosts/{productId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'accountant']);
      allow create, update: if hasRole(['super_admin', 'admin', 'accountant']) && isValidId(productId);
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(productId);
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId) && (resource == null || resource.data.status in ['active', 'scheduled'] || isAdmin());
      allow list: if resource.data.status in ['active', 'scheduled'] || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'sales_mgr']) && isValidId(campaignId) && incoming().nameFa is string && incoming().nameFa.size() <= 160;
      allow delete: if hasRole(['super_admin', 'admin', 'sales_mgr']) && isValidId(campaignId);
    }

    match /bundles/{bundleId} {
      allow get: if isValidId(bundleId) && (resource == null || resource.data.status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) && isValidId(bundleId) && incoming().nameFa is string && incoming().nameFa.size() <= 160;
      allow delete: if hasRole(['super_admin', 'admin', 'sales_mgr']) && isValidId(bundleId);
    }

    match /agents/{agentId} {
      allow get: if isValidId(agentId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content']) && isValidId(agentId) && incoming().nameFa is string && incoming().nameFa.size() <= 160;
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(agentId);
    }

    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && (resource == null || resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content']) && isValidId(postId) && incoming().titleFa is string && incoming().titleFa.size() <= 200;
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(postId);
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'sales_mgr', 'accountant']) && isValidId(couponId) && incoming().code is string && incoming().code.size() <= 40;
      allow delete: if hasRole(['super_admin', 'admin', 'sales_mgr']) && isValidId(couponId);
    }

    match /pages/{pageId} {
      allow get: if isValidId(pageId) && (resource == null || resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content']) && isValidId(pageId);
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(pageId);
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content']) && isValidId(bannerId);
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(bannerId);
    }

    match /faqs/{faqId} {
      allow get: if isValidId(faqId) && (resource == null || resource.data.isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update: if hasRole(['super_admin', 'admin', 'content', 'support']) && isValidId(faqId);
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(faqId);
    }

    match /redirects/{redirectId} {
      allow get: if isValidId(redirectId);
      allow list: if resource.data.fromPath is string;
      allow create, update, delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(redirectId);
    }

    match /notFoundLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create, update: if false;
      allow delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(logId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if resource.data.id is string;
      allow create, update: if hasRole(['super_admin', 'admin']) && isValidId(settingId);
      allow delete: if isSuperAdmin() && isValidId(settingId);
    }

    // --- Public Engagement & Alerts ---
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().status == 'approved' || isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(reviewId) && isValidReview(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update, delete: if hasRole(['super_admin', 'admin', 'content', 'support']) && isValidId(reviewId);
    }

    match /questions/{questionId} {
      allow get: if isValidId(questionId) && (existing().status == 'approved' || isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if resource.data.status == 'approved' || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(questionId) && isValidQuestion(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update, delete: if hasRole(['super_admin', 'admin', 'content', 'support']) && isValidId(questionId);
    }

    match /stockNotifications/{notifId} {
      allow get: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr']) && isValidId(notifId);
      allow list: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr']);
      allow create: if false;
      allow update, delete: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr']) && isValidId(notifId);
    }

    match /newsletterSubscribers/{subId} {
      allow get: if hasRole(['super_admin', 'admin', 'content', 'sales_mgr']) && isValidId(subId);
      allow list: if hasRole(['super_admin', 'admin', 'content', 'sales_mgr']);
      allow create: if false;
      allow update, delete: if hasRole(['super_admin', 'admin', 'content']) && isValidId(subId);
    }

    // --- PII, Warehouse, Finance & Customer-Owned Collections ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().customerGroup == 'retail'
        && incoming().b2bStatus == 'none'
        && (!('isBlocked' in incoming()) || incoming().isBlocked == false)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        hasRole(['super_admin', 'admin', 'sales_mgr', 'support']) || (
          isVerified() && isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().customerGroup == existing().customerGroup
          && incoming().b2bStatus == existing().b2bStatus
          && (!('isBlocked' in incoming()) || incoming().isBlocked == existing().get('isBlocked', false))
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'mobile', 'accountType', 'clinicName', 'medicalCouncilNo', 'specialty', 'legalCompanyName', 'economicCode', 'nationalId', 'registrationNo', 'addresses', 'updatedAt'])
        )
      );
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(userId);
    }

    match /contractPrices/{contractId} {
      allow get: if isValidId(contractId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if hasRole(['super_admin', 'admin', 'sales_mgr', 'accountant']) && isValidId(contractId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if hasRole(['super_admin', 'admin', 'accountant', 'sales_mgr']) && isValidId(invoiceId);
      allow delete: if false;
    }

    match /paymentLedger/{entryId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'accountant', 'sales_mgr']);
      allow create, update: if hasRole(['super_admin', 'admin', 'accountant', 'sales_mgr']) && isValidId(entryId);
      allow delete: if false;
    }

    match /returns/{returnId} {
      allow get: if isValidId(returnId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /proformas/{proformaId} {
      allow get: if isValidId(proformaId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(proformaId) && isValidProforma(incoming())
        && (hasRole(['super_admin', 'admin', 'sales_mgr', 'accountant']) || (incoming().userId == request.auth.uid && incoming().status == 'draft'))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(proformaId) && isValidProforma(incoming()) && (
        hasRole(['super_admin', 'admin', 'sales_mgr', 'accountant']) || (
          isVerified() && existing().userId == request.auth.uid
          && existing().status in ['sent', 'viewed']
          && incoming().status in ['accepted', 'rejected']
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if hasRole(['super_admin', 'admin', 'sales_mgr']) && isValidId(proformaId);
    }

    match /paymentPlans/{planId} {
      allow get: if isValidId(planId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(planId) && isValidPaymentPlan(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasRole(['super_admin', 'admin', 'accountant', 'sales_mgr']) && isValidId(planId) && isValidPaymentPlan(incoming());
      allow delete: if false;
    }

    match /b2bVerifications/{verificationId} {
      allow get: if isValidId(verificationId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(verificationId) && isValidB2BVerification(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if hasRole(['super_admin', 'admin', 'sales_mgr', 'support']) && isValidId(verificationId) && isValidB2BVerification(incoming());
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(verificationId);
    }

    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(ticketId) && isValidTicket(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isValidTicket(incoming()) && (
        hasRole(['super_admin', 'admin', 'support', 'sales_mgr']) || (
          isVerified() && existing().userId == request.auth.uid
          && existing().status != 'closed'
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().status in ['open', 'pending_staff']
          && incoming().messages.size() >= existing().messages.size()
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'status', 'updatedAt'])
        )
      );
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(ticketId);
    }

    match /stockRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(requestId) && isValidStockRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      allow update, delete: if hasRole(['super_admin', 'admin', 'sales_mgr', 'warehouse']) && isValidId(requestId);
    }

    match /consultationRequests/{requestId} {
      allow get: if isValidId(requestId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(requestId) && isValidConsultation(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      allow update, delete: if hasRole(['super_admin', 'admin', 'sales_mgr', 'support']) && isValidId(requestId);
    }

    match /rfqRequests/{rfqId} {
      allow get: if isValidId(rfqId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(rfqId) && isValidRfqRequest(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(rfqId) && isValidRfqRequest(incoming()) && (
        hasRole(['super_admin', 'admin', 'sales_mgr', 'support']) || (
          isVerified() && existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && existing().status in ['submitted', 'in_review', 'quoted']
          && (incoming().status == existing().status || (existing().status == 'quoted' && incoming().status in ['accepted', 'rejected']))
          && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'status', 'updatedAt'])
        )
      );
      allow delete: if hasRole(['super_admin', 'admin']) && isValidId(rfqId);
    }

    match /warehouses/{warehouseId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr', 'accountant']);
      allow create, update, delete: if false;
    }

    match /stockLevels/{levelId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr', 'accountant']);
      allow create, update, delete: if false;
    }

    match /stockBatches/{batchId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr', 'accountant']);
      allow create, update, delete: if false;
    }

    match /suppliers/{supplierId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'warehouse', 'sales_mgr', 'accountant']);
      allow create, update, delete: if hasRole(['super_admin', 'admin', 'warehouse']) && isValidId(supplierId);
    }

    match /stockMovements/{movementId} {
      allow get, list: if hasRole(['super_admin', 'admin', 'warehouse', 'accountant']);
      allow create, update, delete: if false;
    }

    // --- System & Admin Collections ---
    match /auditLogs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin() && isValidId(uid)
        && (!('role' in incoming()) || incoming().role in ['super_admin', 'admin', 'sales_mgr', 'warehouse', 'content', 'support', 'accountant']);
    }

    // --- Phase 9: Marketing Automation Collections (Server-Written Only) ---
    match /outboxMessages/{msgId} {
      allow get: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) && isValidId(msgId);
      allow list: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']);
      allow create, update, delete: if false;
    }

    match /campaignRuns/{runId} {
      allow get: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) && isValidId(runId);
      allow list: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']);
      allow create, update, delete: if false;
    }

    match /marketingConsents/{consentId} {
      allow get: if isValidId(consentId) && (hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /suppressionList/{entryId} {
      allow get: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) && isValidId(entryId);
      allow list: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']);
      allow create, update, delete: if false;
    }

    match /abandonedCarts/{cartId} {
      allow get: if isValidId(cartId) && (hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if hasRole(['super_admin', 'admin', 'sales_mgr', 'content']) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
